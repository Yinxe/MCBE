{
  "name": "@yinxe/mc",
  "version": "1.0.0",
  "private": true,
  "description": "MCBE Addon — Monorepo",
  "packageManager": "pnpm@11.1.3",
  "keywords": ["MCBE","addon","模组","扩展"],
  "author": {
    "name": "Yinx",
