  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.3",
      "onFail": "download"
    }
  },
  "type": "module",
  "scripts": {
    "clean": "pnpm -r run clean",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "build": "pnpm -r run build",
    "build:mock-player": "pnpm --filter mock-player run build",
    "build:keepinventory": "pnpm --filter keepinventory run build",
    "build:smartwarehouse": "pnpm --filter smartwarehouse run build",
    "build:antibundledup": "pnpm --filter antibundledup run build",
    "build:auto-refill": "pnpm --filter auto-refill run build",
    "build:teleporter": "pnpm --filter teleporter run build",
    "build:spectator-mode": "pnpm --filter spectator-mode run build",
    "pack:mock-player": "pnpm --filter mock-player run pack",
    "pack:auto-refill": "pnpm --filter auto-refill run pack",
    "pack:keepinventory": "pnpm --filter keepinventory run pack",
    "pack:craftablerarities": "pnpm --filter craftablerarities run pack",
    "pack:smartwarehouse": "pnpm --filter smartwarehouse run pack",
    "pack:antibundledup": "pnpm --filter antibundledup run pack",
    "pack:teleporter": "pnpm --filter teleporter run pack",
    "pack:spectator-mode": "pnpm --filter spectator-mode run pack",
    "pack:enchanter": "pnpm --filter enchanter run pack",
    "sync-version": "node packages/toolkit-build/bin/sync-version.mjs",
    "pack:stackable": "pnpm --filter stackable run pack",
    "test:auto-refill": "pnpm --filter auto-refill run test:core"
  }
}
