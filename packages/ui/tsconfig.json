{
  "compilerOptions": {
    "target": "es6",
    "module": "ES2020",
    "moduleResolution": "Node",
    "strict": true,
    "declaration": false,
    "noEmit": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowUnreachableCode": true,
    "allowUnusedLabels": true,
    "noImplicitAny": true,
    "noImplicitReturns": false,
    "noImplicitUseStrict": false,
    "noEmitHelpers": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", ".test-build"]
}
