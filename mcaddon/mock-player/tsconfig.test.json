{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "scripts/core/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", ".test-build", "lib", "dist", "scripts/mc/**/*.ts"]
}
