{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": ".test-build",
    "rootDir": "."
  },
  "include": [
    "scripts/bot/BotCore.ts",
    "scripts/rules/**/*.ts",
    "scripts/ai/**/*.ts",
    "scripts/tasks/**/*.ts",
    "scripts/items/**/*.ts",
    "scripts/events/**/*.ts",
    "scripts/model/**/*.ts",
    "scripts/tags/**/*.ts",
    "scripts/coords/**/*.ts",
    "scripts/format/**/*.ts",
    "scripts/xp/**/*.ts",
    "scripts/storage/**/*.ts",
    "scripts/service/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".test-build",
    "lib",
    "dist",
    "scripts/mc/**/*.ts",
    "scripts/core/**/*.ts"
  ]
}
