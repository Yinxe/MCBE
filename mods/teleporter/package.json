{
  "name": "@mc-toolchain/teleporter",
  "version": "0.0.6",
  "productName": "传送",
  "description": "传送管理 · 传送点、死亡点、玩家间传送请求 · 无需作弊 · 保留成就",
  "private": true,
  "dependencies": {
    "@minecraft/server": "2.3.0",
    "@minecraft/server-ui": "2.0.0"
  },
  "devDependencies": {
    "@mc-toolchain/packaging": "*",
    "@mc-toolchain/ui": "*",
    "@minecraft/core-build-tasks": "5.5.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint-plugin-minecraft-linting": "2.0.10",
    "prettier": "3.9.10",
    "source-map": "0.7.4",
    "ts-node": "10.9.1",
    "typescript": "5.5.4"
  },
  "scripts": {
    "lint": "just-scripts lint",
    "build": "just-scripts build",
    "clean": "just-scripts clean",
    "pack": "just-scripts pack",
    "generate:icon": "node tools/generate-pack-icon.js",
    "local-deploy": "just-scripts local-deploy",
    "test": "tsc -p tests/tsconfig.json && node --test \".test-build/tests/**/*.test.js\""
  },
  "packing": {
    "mode": "auto",
    "output": "dist/packages",
    "minimum_engine_version": [1, 21, 120]
  }
}
