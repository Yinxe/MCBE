{
  "format_version": "1.21.0",
  "particle_effect": {
    "description": {
      "identifier": "apitest:box_face",
      "basic_render_parameters": {
        "material": "apitest_blend_cull",
        "texture": "textures/apitest/particle/white"
      }
    },
    "components": {
      "minecraft:emitter_initialization": {
        "creation_expression": "v.pos_x = v.pos_x ?? 0; v.pos_y = v.pos_y ?? 0; v.pos_z = v.pos_z ?? 0; v.normal_x = v.normal_x ?? 0; v.normal_y = v.normal_y ?? 1; v.normal_z = v.normal_z ?? 0; v.width = v.width ?? 1; v.height = v.height ?? 1; v.color_r = v.color_r ?? 1; v.color_g = v.color_g ?? 1; v.color_b = v.color_b ?? 1; v.opacity = v.opacity ?? 0.18; v.duration = v.duration ?? 10; v.fade_in = v.fade_in ?? 0.25; v.fade_out = v.fade_out ?? 0.25;"
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "v.pos_x",
          "v.pos_y",
          "v.pos_z"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "v.duration + 0.05",
        "expiration_expression": "v.particle_age > v.duration"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "v.width",
          "v.height"
        ],
        "facing_camera_mode": "direction_z",
        "direction": {
          "mode": "custom",
          "custom_direction": [
            "v.normal_x",
            "v.normal_y",
            "v.normal_z"
          ]
        },
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.color_r",
          "v.color_g",
          "v.color_b",
          "v.opacity * math.clamp(math.min(v.particle_age / math.max(v.fade_in, 0.01), (v.duration - v.particle_age) / math.max(v.fade_out, 0.01)), 0, 1)"
        ]
      }
    }
  }
}
